# ==========================================
# ตัวแปรที่จำเป็นต่อการรันบอท (คัดลอกไฟล์นี้เป็นชื่อ ".env" แล้วใส่ค่าจริง)
# บน Render ให้ใส่ค่าเหล่านี้ใน "Environment" ของ Web Service แทนการสร้างไฟล์ .env
# ==========================================

# 🔑 Token ของบอท (เอาได้จาก https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=

# 👑 Discord User ID ของเจ้าของบอท (เปิด Developer Mode ใน Discord แล้วคลิกขวาที่โปรไฟล์ตัวเอง -> Copy User ID)
#    ใส่ได้หลาย ID คั่นด้วย , เช่น 111111111111111111,222222222222222222
#    หรือใส่คำว่า ALL เพื่อให้ทุกคนใช้แผงควบคุมได้ (ไม่แนะนำสำหรับบอทสาธารณะ)
OWNER_ID=ALL

# 🕹️ คำสั่งพิมพ์เพื่อเปิดแผงควบคุม (ค่าเริ่มต้นคือ !panel)
PANEL_CMD=!anurak

# 🌐 พอร์ตสำหรับ Web Server กัน Render Sleep (ปกติไม่ต้องแก้ Render จะกำหนดให้เอง)
PORT=3000
